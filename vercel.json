{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/apresentar/priorita",
      "destination": "/apresentar/priorita-serra",
      "permanent": false
    },
    {
      "source": "/apresentar/priorita/",
      "destination": "/apresentar/priorita-serra",
      "permanent": false
    },
    {
      "source": "/spatial",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/apresentar/amici",
      "destination": "/visitar/eme-circular",
      "permanent": false
    },
    {
      "source": "/visitar/amici",
      "destination": "/visitar/eme-circular",
      "permanent": false
    },
    {
      "source": "/projetos/amici",
      "destination": "/visitar/eme-circular",
      "permanent": false
    },
    {
      "source": "/apresentar/aminci",
      "destination": "/visitar/eme-circular",
      "permanent": false
    },
    {
      "source": "/visitar/aminci",
      "destination": "/visitar/eme-circular",
      "permanent": false
    },
    {
      "source": "/projetos/aminci",
      "destination": "/visitar/eme-circular",
      "permanent": false
    },
    {
      "source": "/apresentar/apogeu",
      "destination": "/visitar/eme-circular",
      "permanent": false
    },
    {
      "source": "/visitar/apogeu",
      "destination": "/visitar/eme-circular",
      "permanent": false
    },
    {
      "source": "/projetos/apogeu",
      "destination": "/visitar/eme-circular",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/visitar/:slug",
      "destination": "/visitar/:slug/index.html"
    },
    {
      "source": "/apresentar/botanique",
      "destination": "/botanique.html"
    },
    {
      "source": "/solucoes/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/projetos/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/personalizar",
      "destination": "/index.html"
    },
    {
      "source": "/portal",
      "destination": "/portal.html"
    },
    {
      "source": "/portal/:path*",
      "destination": "/portal.html"
    },
    {
      "source": "/criar-projeto",
      "destination": "/index.html"
    },
    {
      "source": "/criar-projeto/",
      "destination": "/index.html"
    },
    {
      "source": "/apresentar/:path*",
      "destination": "/experience.html"
    },
    {
      "source": "/api/public/developments/moradas-da-serra",
      "destination": "https://www.emeselect.com/api/public/developments/moradas-da-serra"
    }
  ]
}
